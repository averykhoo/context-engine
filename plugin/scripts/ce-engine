#!/bin/sh
# ce-engine: run THIS repo's pinned context-engine for the Claude Code plugin (CE-77, DEC-41).
#
#   sh ce-engine <project dir> orient|mcp
#
# The plugin starts it in exec form as
#   git -c alias.ce-run=!sh ce-run <this file> <project dir> <mode>
# because git is the one real executable every framework repo has on PATH on every OS (exec form
# on Windows needs a real .exe), and git runs the alias with the sh it ships
# (docs/evidence/plugin-design-2026-10-14.md). Keep this file POSIX sh with LF line endings
# (.gitattributes).

# git exports its own repo discovery into an alias (and runs it from that repo's top level); the
# engine runs git itself against the project, so none of it may leak through.
unset GIT_DIR GIT_WORK_TREE GIT_PREFIX GIT_CONFIG_PARAMETERS GIT_CONFIG_COUNT GIT_INDEX_FILE GIT_COMMON_DIR

root=${1:-}
mode=${2:-}
say() { printf '%s\n' "context-engine plugin: $*"; }

case $mode in
  orient|mcp) ;;
  *) say "usage: ce-engine <project dir> orient|mcp (got '$mode')" >&2; exit 2 ;;
esac
if [ -z "$root" ] || [ ! -d "$root" ]; then
  say "the project directory '$root' does not exist" >&2
  exit 2
fi

# A repo the framework does not run: nothing to orient, no server to start.
if [ ! -f "$root/context.toml" ]; then
  if [ "$mode" = mcp ]; then
    say "$root has no context.toml, so context-engine does not run it; the engine's MCP server does not start here" >&2
    exit 1
  fi
  exit 0
fi

# Every hook `command` in a settings file that runs the engine's orient (`context_engine`, then
# `orient`), one line each: its program, a unit separator, its --root (empty when it names none).
# The JSON strings are read with their escapes undone; a permission grant is not a `command`.
orient_hooks() {
  awk '
    function word(t,   q, j) {
      sub(/^[ \t]+/, "", t)
      q = substr(t, 1, 1)
      if (q == "\"" || q == "\047") {
        t = substr(t, 2); j = index(t, q)
        return j ? substr(t, 1, j - 1) : t
      }
      if (match(t, /^[^ \t]+/)) return substr(t, 1, RLENGTH)
      return ""
    }
    function emit(s,   p, j, r) {
      p = index(s, "context_engine")
      if (!p || !index(substr(s, p), "orient")) return
      p = s; sub(/^[ \t]+/, "", p)
      if (substr(p, 1, 2) == "& ") p = substr(p, 3)
      r = ""; j = index(s, "--root")
      if (j) { r = substr(s, j + 6); if (substr(r, 1, 1) == "=") r = substr(r, 2); r = word(r) }
      printf "%s\037%s\n", word(p), r
    }
    { buf = buf $0 "\n" }
    END {
      n = length(buf); i = 1; key = ""; last = ""; value = 0
      while (i <= n) {
        c = substr(buf, i, 1)
        if (c == "\"") {
          s = ""; i++
          while (i <= n) {
            c = substr(buf, i, 1)
            if (c == "\\") {
              d = substr(buf, i + 1, 1)
              s = s ((d == "\"" || d == "\\" || d == "/") ? d : c d); i += 2; continue
            }
            if (c == "\"") break
            s = s c; i++
          }
          i++
          if (value) { if (key == "command") emit(s); value = 0; key = "" } else last = s
          continue
        }
        if (c == ":") { key = last; value = 1 }
        else if (c !~ /[ \t\r\n]/) { value = 0; last = "" }
        i++
      }
    }
  ' "$1"
}

# Orient never runs twice: Claude Code runs a plugin's hook and a settings file's both, so this one
# stays quiet beside a SessionStart hook in the repo's own settings that runs the engine's orient
# (init writes one) and can run here: its program is a file on this machine (a bare name: one on
# PATH) and its --root, when it names one, is this repo. A program or --root that names a variable
# ($, %) or starts with ~ is not judged: the hook's shell expands it, this one cannot. A
# stale one (another machine's path, a moved repo or interpreter) fails silently, so beside only
# stale ones this one runs orient and says which hook it stood in for (CE-146).
stale=
if [ "$mode" = orient ]; then
  us=$(printf '\037')
  for s in "$root/.claude/settings.local.json" "$root/.claude/settings.json"; do
    [ -f "$s" ] || continue
    hooks=$(orient_hooks "$s") || hooks=
    while IFS=$us read -r prog r; do
      [ -n "$prog" ] || continue
      why=
      case $prog in
        *'$'*|*%*|'~'*) ;;
        */*|*\\*) (cd "$root" && [ -f "$prog" ]) || why="its program $prog is not a file on this machine" ;;
        *) command -v "$prog" >/dev/null 2>&1 || why="its program $prog is not on PATH" ;;
      esac
      case $r in
        *'$'*|*%*|'~'*) r= ;;
      esac
      if [ -z "$why" ] && [ -n "$r" ] && ! (cd "$root" && [ -d "$r" ] && [ "$r" -ef . ]); then
        why="its --root $r is not this repo"
      fi
      [ -n "$why" ] || exit 0
      stale=${stale:-"the SessionStart hook in ${s#"$root"/} runs the engine's orient, but $why"}
    done <<EOF
$hooks
EOF
  done
fi
if [ -n "$stale" ]; then
  say "$stale; a failing SessionStart hook is silent, so the plugin runs orient instead: have the owner fix or remove that hook (kit README § Hook)."
fi

# The interpreter: the pointer file if the repo has one, else the pinned env's (DEC-41), in its
# three layouts: posix venv or conda (bin/python), Windows conda -p (python.exe), Windows venv
# (Scripts/python.exe).
dir=$root/.context-engine
py=
if [ -f "$dir/engine-python" ]; then
  py=$(sed -n '1{s/\r$//;p;}' "$dir/engine-python")
  where="$dir/engine-python names '$py', which is not a file"
  [ -n "$py" ] && [ -f "$py" ] || py=
else
  where="no engine env at $dir/env (looked for bin/python, python.exe and Scripts/python.exe) and no $dir/engine-python"
  for c in "$dir/env/bin/python" "$dir/env/python.exe" "$dir/env/Scripts/python.exe"; do
    if [ -f "$c" ]; then py=$c; break; fi
  done
fi
if [ -z "$py" ]; then
  fix="install the engine there, pinned (kit README § 1, DEC-41), or write the engine interpreter's path as the one line of $dir/engine-python"
  if [ "$mode" = orient ]; then
    # stdout reaches the session's context, where a silent failure would not (a failing
    # SessionStart hook shows its error to the user only)
    say "orient did not run: $where. Run orient by hand and tell the owner; to fix, $fix."
    exit 0
  fi
  say "the MCP server did not start: $where. To fix, $fix." >&2
  exit 1
fi

cd "$root" || exit 1
if [ "$mode" = orient ]; then
  exec "$py" -m context_engine --root "$root" orient
fi
exec "$py" -m context_engine.mcp --root "$root"
